MONGO_URL="mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<nombre_db>"

# Autenticación JWT
JWT_SECRET="genera-una-clave-aleatoria-de-al-menos-32-caracteres"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS="http://127.0.0.1:8001,http://localhost:8001"
APP_ENV="development"

# Usuario administrador inicial (src/scripts/seed_admin.py)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@techgear.com"
# Configura un valor aleatorio de al menos 12 caracteres antes de sembrar el admin.
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="Administrador TechGear"
